# ── Discord bot (set these as Variables in Railway) ──────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your Discord server (guild) ID — right-click the server icon → Copy Server ID
GUILD_ID=

# The @Staff Team role ID — right-click the role → Copy Role ID (needs Developer Mode ON)
STAFF_ROLE_ID=

# ── Welcome message (optional) ───────────────────────────────────────────────
# Channel where welcome messages are posted. Leave empty to disable welcomes.
WELCOME_CHANNEL_ID=
# {user} = @mention, {name} = plain username
WELCOME_MESSAGE=Welcome to **PolarisSMP**, {user}! 🎉 Check the rules and have fun!

# ── Ticket categories (optional) ─────────────────────────────────────────────
# A Discord CATEGORY ID per ticket type — new tickets are created inside it.
# Leave a type empty to fall back to DEFAULT_TICKET_CATEGORY_ID (or no category).
SUPPORT_CATEGORY_ID=
PARTNERSHIP_CATEGORY_ID=
RANK_CATEGORY_ID=
WEBSITE_CATEGORY_ID=
PRIZE_CATEGORY_ID=
DEFAULT_TICKET_CATEGORY_ID=
